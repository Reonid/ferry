# Absolute base URL, e.g. https://localhost:3000 locally
NEXT_PUBLIC_BASE_URL=
# iron-session password, 32+ characters
SESSION_SECRET=
# 32 random bytes, base64 (encrypts tokens and webhook URLs at rest)
ENCRYPTION_KEY=
# Buffer app client (Settings -> API -> App Clients)
BUFFER_CLIENT_ID=
# Buffer app client secret
BUFFER_CLIENT_SECRET=
# Discord application client ID (OAuth2, scope webhook.incoming)
DISCORD_CLIENT_ID=
# Discord application client secret
DISCORD_CLIENT_SECRET=
# Production store; without it, development uses an in-memory store
UPSTASH_REDIS_REST_URL=
# Upstash Redis REST token (pairs with the URL above)
UPSTASH_REDIS_REST_TOKEN=
# Creates the 2-minute tick schedule (scripts/create-schedule.mjs)
QSTASH_TOKEN=
# Verifies /api/tick calls
QSTASH_CURRENT_SIGNING_KEY=
# Next signing key, used during QStash key rotation
QSTASH_NEXT_SIGNING_KEY=
# Telegram bot token from @BotFather; optional, leave empty to turn Telegram off
TELEGRAM_BOT_TOKEN=
# The bot's username without the @, used to build the t.me links
TELEGRAM_BOT_USERNAME=
# "1" enables /api/dev/login, development only
FERRY_DEV_LOGIN=
