{
  "name": "ferry",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev --experimental-https",
    "dev:e2e": "FERRY_DEV_LOGIN=1 next dev --port 3100",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "schedule": "node scripts/create-schedule.mjs"
  },
  "dependencies": {
    "@upstash/qstash": "^2.12.1",
    "@upstash/redis": "^1.41.0",
    "iron-session": "^8.0.4",
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.1",
    "eslint-config-prettier": "^10.1.8",
    "graphql": "^17.0.2",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
